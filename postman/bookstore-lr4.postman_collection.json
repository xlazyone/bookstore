{
  "info": {
    "name": "BookStore LR4",
    "description": "Демо-запросы ЛР4 через API Gateway. Запускать по порядку папок.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "1. Catalog",
      "item": [
        {
          "name": "List books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/books"
          }
        },
        {
          "name": "Search books",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/books?q=война",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","books"],
              "query": [{ "key": "q", "value": "война" }]
            }
          }
        },
        {
          "name": "Get book by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/books/{{bookId}}"
          }
        },
        {
          "name": "Get book rating",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/books/{{bookId}}/rating"
          }
        }
      ]
    },
    {
      "name": "2. Cart",
      "item": [
        {
          "name": "Add to cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/api/v1/cart/items"
          }
        },
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": "{{baseUrl}}/api/v1/cart"
          }
        }
      ]
    },
    {
      "name": "3. Order - happy path",
      "item": [
        {
          "name": "Create order (SUCCESS)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j && j.id) pm.environment.set('orderId', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"RUB\",\n  \"simulatePayment\": \"SUCCESS\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders"
          }
        },
        {
          "name": "Get order status",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "4. Order - failure path",
      "item": [
        {
          "name": "Create order (FAIL)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currency\": \"RUB\",\n  \"simulatePayment\": \"FAIL\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders"
          }
        }
      ]
    },
    {
      "name": "5. Reviews",
      "item": [
        {
          "name": "Create review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"text\": \"Отличная книга\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/books/{{bookId}}/reviews"
          }
        },
        {
          "name": "List reviews",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/books/{{bookId}}/reviews"
          }
        },
        {
          "name": "Moderate review (APPROVE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Roles", "value": "MODERATOR" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/reviews/PASTE_REVIEW_ID/moderate"
          }
        }
      ]
    },
    {
      "name": "6. Admin",
      "item": [
        {
          "name": "Restock",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Roles", "value": "MANAGER" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": 10,\n  \"reason\": \"RESTOCK\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/stock/{{bookId}}"
          }
        },
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Roles", "value": "MANAGER" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"9785000000123\",\n  \"title\": \"Postman Book\",\n  \"authorId\": \"11111111-1111-1111-1111-111111111111\",\n  \"genreId\": \"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\",\n  \"price\": 100\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/books"
          }
        }
      ]
    },
    {
      "name": "7. Error examples (RFC 7807)",
      "item": [
        {
          "name": "404 Book not found",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/books/00000000-0000-0000-0000-000000000000"
          }
        },
        {
          "name": "404 Route not found",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/unknown"
          }
        },
        {
          "name": "403 Without MANAGER role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/v1/admin/books"
          }
        }
      ]
    }
  ]
}
