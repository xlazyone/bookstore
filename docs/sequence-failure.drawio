  <diagram id="qFJMmLqZlu_1-Fo8TuRO" name="Страница-2">
    <mxGraphModel dx="2174" dy="813" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    Client[\&quot;👤 Client\&quot;]\n    GW[\&quot;API Gateway (Nginx)\&quot;]\n    KC[\&quot;Keycloak\&quot;]\n\n    subgraph Services[\&quot;Бизнес-сервисы\&quot;]\n        Cat[\&quot;catalog-service\&quot;]\n        Inv[\&quot;inventory-service\&quot;]\n        Ord[\&quot;order-service\&quot;]\n        Pay[\&quot;payment-service\&quot;]\n        Rev[\&quot;review-service\&quot;]\n        Not[\&quot;notification-service\&quot;]\n    end\n\n    subgraph Storage[\&quot;Хранилища\&quot;]\n        CatPG[(\&quot;PostgreSQL catalog\&quot;)]\n        InvPG[(\&quot;PostgreSQL inventory\&quot;)]\n        OrdPG[(\&quot;PostgreSQL order\&quot;)]\n        PayPG[(\&quot;PostgreSQL payment\&quot;)]\n        RevM[(\&quot;MongoDB review\&quot;)]\n        NotM[(\&quot;MongoDB notification\&quot;)]\n        CatR[(\&quot;Redis catalog\&quot;)]\n        InvR[(\&quot;Redis inventory\&quot;)]\n        S3[(\&quot;MinIO covers\&quot;)]\n    end\n\n    MQ[(\&quot;RabbitMQ\&quot;)]\n    PG[\&quot;Payment Gateway (external)\&quot;]\n    MH[\&quot;MailHog (dev SMTP)\&quot;]\n\n    %% Client → Gateway\n    Client --&gt;|\&quot;HTTPS: /api/v1/**\&quot;| GW\n    GW -.-&gt;|\&quot;HTTPS: verify JWT\&quot;| KC\n\n    %% Gateway → public endpoints\n    GW --&gt;|\&quot;REST: /api/v1/books\&quot;| Cat\n    GW --&gt;|\&quot;REST: /api/v1/admin/books,&lt;br/&gt;/api/v1/admin/stock\&quot;| Inv\n    GW --&gt;|\&quot;REST: /api/v1/orders\&quot;| Ord\n    GW --&gt;|\&quot;REST: /api/v1/payments/{id}\&quot;| Pay\n    GW --&gt;|\&quot;REST: /api/v1/books/{id}/reviews\&quot;| Rev\n\n    %% Service-to-service (sync, internal)\n    Ord --&gt;|\&quot;REST: GET /internal/v1/books:batch\&quot;| Cat\n    Ord --&gt;|\&quot;REST: POST /internal/v1/reservations\&quot;| Inv\n    Ord --&gt;|\&quot;REST: POST /internal/v1/payments\&quot;| Pay\n\n    %% Async: publishers\n    Ord -.-&gt;|\&quot;publish:&lt;br/&gt;order.created, order.confirmed,&lt;br/&gt;order.cancelled, order.expired\&quot;| MQ\n    Pay -.-&gt;|\&quot;publish:&lt;br/&gt;payment.completed, payment.failed,&lt;br/&gt;payment.refunded\&quot;| MQ\n    Inv -.-&gt;|\&quot;publish:&lt;br/&gt;stock.reserved, stock.released,&lt;br/&gt;stock.reservation.expired\&quot;| MQ\n    Rev -.-&gt;|\&quot;publish: review.published\&quot;| MQ\n    Not -.-&gt;|\&quot;publish:&lt;br/&gt;notification.sent, notification.failed\&quot;| MQ\n\n    %% Async: subscribers\n    MQ -.-&gt;|\&quot;subscribe:&lt;br/&gt;payment.completed, payment.failed\&quot;| Ord\n    MQ -.-&gt;|\&quot;subscribe: order.expired\&quot;| Pay\n    MQ -.-&gt;|\&quot;subscribe:&lt;br/&gt;order.confirmed, order.cancelled\&quot;| Inv\n    MQ -.-&gt;|\&quot;subscribe: order.confirmed\&quot;| Rev\n    MQ -.-&gt;|\&quot;subscribe:&lt;br/&gt;order.confirmed, order.cancelled,&lt;br/&gt;payment.completed, payment.failed,&lt;br/&gt;review.published\&quot;| Not\n\n    %% External\n    Pay --&gt;|\&quot;HTTPS: POST /payments\&quot;| PG\n    PG -.-&gt;|\&quot;HTTPS webhook\&quot;| Pay\n    Not --&gt;|\&quot;SMTP: send\&quot;| MH\n\n    %% Storage\n    Cat --&gt; CatPG\n    Cat --&gt; CatR\n    Cat --&gt; S3\n    Inv --&gt; InvPG\n    Inv --&gt; InvR\n    Ord --&gt; OrdPG\n    Pay --&gt; PayPG\n    Rev --&gt; RevM\n    Not --&gt; NotM\n\n    classDef svc fill:#dae8fc,stroke:#6c8ebf,color:#000\n    classDef db fill:#d5e8d4,stroke:#82b366,color:#000\n    classDef infra fill:#fff2cc,stroke:#d6b656,color:#000\n    classDef ext fill:#f8cecc,stroke:#b85450,color:#000\n\n    class Cat,Inv,Ord,Pay,Rev,Not svc\n    class CatPG,InvPG,OrdPG,PayPG,RevM,NotM,CatR,InvR,S3 db\n    class GW,KC,MQ infra\n    class PG,MH,Client ext&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="pAARZLXjjHLFE3CaUKM3-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
